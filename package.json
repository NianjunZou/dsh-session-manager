{
  "name": "@pianner/dsh-session-manager",
  "version": "0.1.7",
  "description": "Codex-style left session manager for DSH workspaces.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "docs",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "PLUGIN-CONTRACT.md",
    "LICENSE",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "verify:contract": "node scripts/check-plugin-contract.mjs .",
    "verify": "npm run build && node --check client/client.js && npm test && npm run verify:contract",
    "build": "node scripts/build-client.mjs",
    "test:core": "node --test test/core.test.js",
    "verify:align": "DSH_SOURCE=${DSH_SOURCE:-$HOME/deepseek-harness} node --test test/alignment.test.js",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sessions",
    "codex"
  ],
  "license": "MIT",
  "author": "nianjunzou",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NianjunZou/dsh-session-manager.git"
  },
  "homepage": "https://github.com/NianjunZou/dsh-session-manager#readme",
  "bugs": {
    "url": "https://github.com/NianjunZou/dsh-session-manager/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-job-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.0-alpha.0 <0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-api-job-controller": ">=0.2.0-alpha.0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-job-controller": {
      "optional": true
    }
  }
}
